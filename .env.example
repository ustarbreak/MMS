# ─── Supabase Configuration ────────────────────────────────────────────────────
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT:
# - The anon key is SAFE to expose in frontend code
# - NEVER use the service_role key in frontend code
# - Security is enforced via Row Level Security (RLS) policies

# ─── Contact Form Configuration ────────────────────────────────────────────────
# Web3Forms provides free contact form handling (250 submissions/month)
# Get your access key at: https://web3forms.com
# 
# If not configured, the contact form will show an error message
# directing users to email directly.

VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# ─── Optional Configuration ────────────────────────────────────────────────────
# These are optional and have sensible defaults

# VITE_CONTACT_EMAIL=hello@mediasmakers.com
# VITE_DEFAULT_CURRENCY=EUR
